.rank-container {
  min-height: 100vh;
  background: #f8f8f8;
  padding: 40rpx 30rpx;
}

.rank-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 800;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #999;
}

.rank-list {
  background: #fff;
  border-radius: 24rpx;
  padding: 10rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.rank-item:last-child { border-bottom: none; }
.rank-item.is-me { background: rgba(108, 99, 255, 0.02); }

.rank-num {
  width: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #999;
  font-style: italic;
}

.gold { color: #f1c40f; font-size: 40rpx; }
.silver { color: #bdc3c7; font-size: 38rpx; }
.bronze { color: #e67e22; font-size: 36rpx; }

.avatar-box {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 24rpx;
  background: #eee;
}

.avatar { width: 100%; height: 100%; }

.info { flex: 1; }
.name-row { display: flex; align-items: center; margin-bottom: 4rpx; }
.name { font-size: 30rpx; font-weight: bold; color: #333; }
.me-tag {
  font-size: 18rpx;
  background: #6c63ff;
  color: #fff;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 10rpx;
}
.desc { font-size: 22rpx; color: #ccc; }

.score {
  font-size: 36rpx;
  font-weight: 800;
}
.pos { color: #ff9500; }
.neg { color: #27ae60; }

.empty {
  text-align: center;
  color: #ccc;
  margin-top: 200rpx;
}

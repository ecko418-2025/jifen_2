<view class="container">
  <view class="card">
    <view class="logo-area">
      <text class="logo-icon">🐺</text>
      <text class="logo-title">狼人杀积分助手</text>
      <text class="logo-subtitle">网页管理后台登录授权</text>
    </view>

    <!-- 未加载状态 -->
    <view wx:if="{{loading}}" class="loading-state">
      <view class="spinner"></view>
      <text class="loading-text">正在验证管理员权限...</text>
    </view>

    <!-- 授权主界面 -->
    <view wx:else class="auth-area">
      <view class="user-card">
        <view class="avatar-placeholder">👤</view>
        <text class="nickname">{{nickname || '房主'}}</text>
        <text class="role-badge">管理员</text>
      </view>

      <view class="warning-box">
        <text class="warning-title">⚠️ 安全登录提示</text>
        <text class="warning-desc">当前微信正在申请登录网页管理后台。为确保分数数据安全，请确认是您本人在浏览器前进行操作。</text>
      </view>

      <view class="button-group">
        <button class="btn btn-primary" bindtap="confirmAuth" loading="{{submitting}}">确认授权登录</button>
        <button class="btn btn-secondary" bindtap="cancelAuth" disabled="{{submitting}}">取消</button>
      </view>
    </view>
  </view>
</view>

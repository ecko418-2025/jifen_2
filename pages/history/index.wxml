<view class="container">
  <view class="header">
    <text class="back-btn" bindtap="goBack">〈</text>
    <text class="title">历史房间</text>
  </view>

  <scroll-view scroll-y class="room-list" refresher-enabled="{{true}}" refresher-triggered="{{loading}}" bindrefresherrefresh="loadHistory">
    <view class="room-item" wx:for="{{rooms}}" wx:key="room_id" bindtap="enterRoom" data-id="{{item.room_id}}" bindlongpress="onLongPressRoom">
      <view class="room-main">
        <view class="room-icon">🏠</view>
        <view class="room-info">
          <view class="room-title-row">
            <text class="room-code">房间: {{item.room_code}}</text>
            <text class="status-tag closed" wx:if="{{item.status === 'closed'}}">已结算</text>
            <text class="status-tag active" wx:else>进行中</text>
          </view>
          <text class="room-date">{{item.date_str}}</text>
        </view>
      </view>
      <view class="room-side">
        <view class="room-score {{item.my_score > 0 ? 'pos' : (item.my_score < 0 ? 'neg' : '')}}">
          {{item.my_score > 0 ? '+' : ''}}{{item.my_score}}
        </view>
        <view class="trend-btn-mini" catchtap="showRoomTrend" data-id="{{item.room_id}}" data-code="{{item.room_code}}">
          📈 走势
        </view>
      </view>
    </view>

    <view class="empty-tip" wx:if="{{rooms.length === 0 && !loading}}">
      暂无历史记录
    </view>
  </scroll-view>

  <!-- 走势图弹窗 -->
  <view class="trend-modal" wx:if="{{showTrend}}">
    <view class="trend-mask" bindtap="hideTrendModal"></view>
    <view class="trend-content">
      <view class="trend-header">
        <text class="trend-title">房间 [{{trendRoomCode}}] 积分走势</text>
        <text class="trend-close" bindtap="hideTrendModal">×</text>
      </view>
      <view class="trend-body">
        <canvas type="2d" id="trendCanvas" class="trend-canvas"></canvas>
        <view class="trend-stats">
          <view class="stat-item">
            <text class="stat-label">最终总分</text>
            <text class="stat-val {{trendFinalScore >= 0 ? 'pos' : 'neg'}}">{{trendFinalScore}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">单局最高</text>
            <text class="stat-val pos">+{{trendMaxDelta}}</text>
          </view>
        </view>
      </view>
      <view class="trend-footer">
        <button class="btn-close-trend" bindtap="hideTrendModal">确定</button>
      </view>
    </view>
  </view>

  <view class="footer-tip">* 长按可以隐藏不再想看到的房间</view>
</view>

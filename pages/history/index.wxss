.container {
  min-height: 100vh;
  background: #f8f8f8;
  display: flex;
  flex-direction: column;
}

.header {
  height: 88rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  border-bottom: 1rpx solid #eee;
}

.back-btn {
  font-size: 40rpx;
  color: #333;
  padding: 20rpx 20rpx 20rpx 0;
}

.title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 40rpx;
}

.room-list {
  flex: 1;
  padding: 20rpx;
  box-sizing: border-box;
}

.room-item {
  background: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.02);
  margin-bottom: 16rpx;
}

.room-main {
  display: flex;
  align-items: center;
}

.room-icon {
  width: 80rpx;
  height: 80rpx;
  background: #f0f7ff;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #3498db;
  margin-right: 20rpx;
}

.room-info {
  display: flex;
  flex-direction: column;
}

.room-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 4rpx;
}

.room-code {
  font-size: 30rpx;
  font-weight: bold;
  color: #27ae60;
}

.status-tag {
  font-size: 20rpx;
  line-height: 1;
  padding: 6rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
}

.status-tag.active {
  color: #1e824c;
  background: #eaf7ef;
}

.status-tag.closed {
  color: #666;
  background: #f0f0f0;
}

.room-date {
  font-size: 22rpx;
  color: #999;
}

.room-score {
  font-size: 32rpx;
  font-weight: bold;
}

.pos { color: #e74c3c !important; }
.neg { color: #27ae60 !important; }

.empty-tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  margin-top: 100rpx;
}

.footer-tip {
  text-align: center;
  font-size: 22rpx;
  color: #ccc;
  padding: 30rpx;
}

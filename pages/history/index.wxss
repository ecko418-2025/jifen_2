.container {
  min-height: 100vh;
  background: #f8f8f8;
  display: flex;
  flex-direction: column;
}

.header {
  height: 88rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  border-bottom: 1rpx solid #eee;
}

.back-btn {
  font-size: 40rpx;
  color: #333;
  padding: 20rpx 20rpx 20rpx 0;
}

.title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 40rpx;
}

.room-list {
  flex: 1;
  padding: 20rpx;
  box-sizing: border-box;
}

.room-item {
  background: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.02);
  margin-bottom: 16rpx;
}

.room-main {
  display: flex;
  align-items: center;
}

.room-icon {
  width: 80rpx;
  height: 80rpx;
  background: #f0f7ff;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #3498db;
  margin-right: 20rpx;
}

.room-info {
  display: flex;
  flex-direction: column;
}

.room-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 4rpx;
}

.room-code {
  font-size: 30rpx;
  font-weight: bold;
  color: #27ae60;
}

.status-tag {
  font-size: 20rpx;
  line-height: 1;
  padding: 6rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
}

.status-tag.active {
  color: #1e824c;
  background: #eaf7ef;
}

.status-tag.closed {
  color: #666;
  background: #f0f0f0;
}

.room-date {
  font-size: 22rpx;
  color: #999;
}

.room-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.room-score {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.trend-btn-mini {
  font-size: 20rpx;
  color: #6c63ff;
  background: rgba(108, 99, 255, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(108, 99, 255, 0.2);
}

.pos { color: #e74c3c !important; }
.neg { color: #27ae60 !important; }

/* 走势图弹窗 */
.trend-modal { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 2000; display: flex; align-items: center; justify-content: center; }
.trend-mask { position: absolute; width: 100%; height: 100%; background: rgba(0,0,0,0.7); backdrop-filter: blur(5px); }
.trend-content { position: relative; width: 680rpx; background: #fff; border-radius: 32rpx; overflow: hidden; animation: popIn 0.3s ease-out; display: flex; flex-direction: column; }
.trend-header { padding: 30rpx 40rpx; display: flex; justify-content: space-between; align-items: center; border-bottom: 1rpx solid #eee; }
.trend-title { font-size: 28rpx; font-weight: bold; color: #333; }
.trend-close { font-size: 40rpx; color: #999; padding: 10rpx; }
.trend-body { padding: 40rpx; display: flex; flex-direction: column; }
.trend-canvas { width: 100%; height: 400rpx; background: #fcfcfc; border-radius: 12rpx; }
.trend-stats { display: flex; justify-content: space-around; margin-top: 40rpx; padding: 30rpx; background: #f8f9fa; border-radius: 20rpx; }
.stat-item { display: flex; flex-direction: column; align-items: center; }
.stat-label { font-size: 22rpx; color: #999; margin-bottom: 8rpx; }
.stat-val { font-size: 36rpx; font-weight: bold; }
.trend-footer { padding: 0 40rpx 50rpx; }
.btn-close-trend { width: 100% !important; height: 88rpx; background: #6c63ff; color: #fff; font-size: 28rpx; border-radius: 44rpx; display: flex; align-items: center; justify-content: center; margin: 0 !important; }

@keyframes popIn {
  from { transform: scale(0.8); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.empty-tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  margin-top: 100rpx;
}

.footer-tip {
  text-align: center;
  font-size: 22rpx;
  color: #ccc;
  padding: 30rpx;
}

.lobby {
  min-height: 100vh;
  background: #f8f8f8;
  padding: 30rpx;
  padding-bottom: 60rpx;
}

.user-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
  margin-bottom: 40rpx;
}

.profile {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  border-radius: 50%;
  margin: 0 30rpx 0 0;
  overflow: hidden;
  background: #eee;
}

.avatar { width: 100%; height: 100%; }

.info { flex: 1; }
.name-input { font-size: 36rpx; font-weight: bold; color: #000; margin-bottom: 10rpx; height: 50rpx; }

.stats {
  display: flex;
  justify-content: space-around;
  align-items: center;
  border-top: 1rpx solid #f5f5f5;
  border-bottom: 1rpx solid #f5f5f5;
  padding: 30rpx 0;
  margin-bottom: 20rpx;
}

.stat-item { text-align: center; }
.stat-item .num { font-size: 32rpx; font-weight: bold; display: block; color: #000; }
.stat-item .label { font-size: 22rpx; color: #666; }
.divider { width: 1rpx; height: 40rpx; background: #eee; }

.record { 
  font-size: 24rpx; 
  color: #333; 
  display: flex; 
  justify-content: space-between; 
  align-items: center;
  padding: 20rpx 10rpx; 
  font-weight: 500; 
  background: #fff9f0;
  border-radius: 12rpx;
  margin-top: 10rpx;
}
.record:active { background: #fee7cc; }
.record-left { display: flex; flex-direction: column; }
.record .rate { color: #ff9500; font-weight: bold; margin-top: 4rpx; }
.arrow { font-size: 22rpx; color: #ccc; }

.actions { margin-bottom: 60rpx; }
.sub-title { font-size: 26rpx; color: #666; margin-bottom: 24rpx; display: block; padding-left: 10rpx; font-weight: bold; }

.btn-row { display: flex; gap: 20rpx; }
.main-btn {
  flex: 1;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-weight: bold;
  font-size: 30rpx;
}

.create { background: #e67e22; color: #fff; }
.join { background: #fff; border: 1rpx solid #ddd; color: #333; }

.manual-join-row {
  display: flex;
  margin-top: 24rpx;
  gap: 20rpx;
}
.manual-input {
  flex: 1;
  height: 90rpx;
  background: #fff;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #000;
}
.manual-btn {
  width: 180rpx;
  height: 90rpx;
  background: #3498db;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.room-list .list-header {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
  font-weight: bold;
}

.room-item {
  background: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.02);
  margin-bottom: 16rpx;
}

.room-info { display: flex; align-items: center; flex: 1; }
.room-icon { width: 80rpx; height: 80rpx; background: #f0f7ff; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; font-size: 40rpx; color: #3498db; }
.room-detail { display: flex; flex-direction: column; margin-left: 20rpx; }
.code { color: #27ae60; font-weight: bold; font-size: 30rpx; margin-bottom: 4rpx; }
.date { font-size: 22rpx; color: #999; }

.enter-link { color: #e67e22; font-size: 28rpx; font-weight: bold; }
.no-room { text-align: center; color: #ccc; font-size: 24rpx; padding: 60rpx 0; }

/* 战绩详情弹窗 */
.stats-modal { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 2000; display: flex; align-items: center; justify-content: center; }
.stats-mask { position: absolute; width: 100%; height: 100%; background: rgba(0,0,0,0.7); backdrop-filter: blur(5px); }
.stats-content { position: relative; width: 620rpx; background: #fff; border-radius: 32rpx; overflow: hidden; animation: statsPop 0.3s ease-out; }
.stats-header { padding: 40rpx; display: flex; justify-content: space-between; align-items: center; border-bottom: 1rpx solid #eee; }
.stats-header text { font-size: 32rpx; font-weight: bold; color: #333; }
.stats-close { font-size: 44rpx; color: #999; padding: 10rpx; }
.stats-body { padding: 40rpx; }

.stats-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.grid-item { 
  width: calc(50% - 10rpx); 
  background: #f9f9f9; 
  padding: 30rpx 20rpx; 
  border-radius: 20rpx; 
  display: flex; 
  flex-direction: column; 
  align-items: center;
  box-sizing: border-box;
}
.grid-val { font-size: 36rpx; font-weight: bold; margin-bottom: 8rpx; color: #333; }
.grid-label { font-size: 22rpx; color: #999; }

.pos { color: #e74c3c !important; }
.neg { color: #27ae60 !important; }
.highlight { color: #ff9500 !important; }

.stats-tips { text-align: center; font-size: 22rpx; color: #ccc; margin-top: 40rpx; }

/* 个人信息弹窗样式 */
.p-modal { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 2000; display: flex; align-items: center; justify-content: center; }
.p-mask { position: absolute; width: 100%; height: 100%; background: rgba(0,0,0,0.8); backdrop-filter: blur(10px); }
.p-content { position: relative; width: 620rpx; background: #fff; border-radius: 48rpx; padding: 80rpx 50rpx; display: flex; flex-direction: column; align-items: center; animation: pModalShow 0.4s cubic-bezier(0.18, 0.89, 0.32, 1.28); box-sizing: border-box; }

@keyframes pModalShow {
  from { opacity: 0; transform: scale(0.8); }
  to { opacity: 1; transform: scale(1); }
}

.p-title { font-size: 40rpx; font-weight: bold; color: #333; margin-bottom: 10rpx; }
.p-desc { font-size: 26rpx; color: #999; margin-bottom: 50rpx; }

.p-avatar-wrap { background: none; padding: 0; margin: 0 0 60rpx 0; line-height: 1; position: relative; width: 220rpx; height: 220rpx; display: flex; align-items: center; justify-content: center; }
.p-avatar-wrap::after { border: none; }
.p-avatar-img { width: 200rpx; height: 200rpx; border-radius: 50%; border: 8rpx solid #f0f0f0; background: #f8f8f8; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05); }
.p-avatar-edit { position: absolute; bottom: 0rpx; left: 50%; transform: translateX(-50%); background: #6c63ff; color: #fff; font-size: 22rpx; padding: 6rpx 20rpx; border-radius: 30rpx; white-space: nowrap; font-weight: bold; }

.p-input-wrap { width: 100%; background: #f8f8f8; border-radius: 24rpx; padding: 30rpx; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; margin-bottom: 80rpx; }
.p-label { font-size: 28rpx; color: #999; margin-bottom: 20rpx; font-weight: bold; }
.p-nickname-input { width: 100%; font-size: 36rpx; color: #333; font-weight: bold; text-align: center; }

.p-footer { width: 100%; }
.p-btn-confirm { background: linear-gradient(135deg, #6c63ff, #4834d4); color: #fff; border-radius: 50rpx; font-size: 32rpx; font-weight: bold; height: 100rpx; display: flex; align-items: center; justify-content: center; box-shadow: 0 10rpx 30rpx rgba(108, 99, 255, 0.3); }
.p-btn-confirm:active { transform: scale(0.98); opacity: 0.9; }

@keyframes statsPop {
  from { transform: translateY(100rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

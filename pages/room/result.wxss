.result-container {
  padding: 60rpx 40rpx;
  background: #f8f8f8;
  min-height: 100vh;
  color: #333;
}

.podium {
  text-align: center;
  margin-bottom: 60rpx;
}

.congrats {
  font-size: 32rpx;
  color: #666;
  font-weight: bold;
}

.winner-card {
  background: linear-gradient(135deg, #fffbeb, #ffecd2);
  border-radius: 40rpx;
  padding: 60rpx;
  margin-top: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(255, 149, 0, 0.15);
  color: #333;
  border: 1rpx solid #ffe4b5;
}

.label {
  font-size: 24rpx;
  font-weight: bold;
  color: #e67e22;
  display: block;
}

.winner-name {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
  margin: 10rpx 0;
  color: #000;
}

.winner-score {
  font-size: 60rpx;
  font-weight: 800;
  color: #e74c3c;
}

/* AI 战报样式 */
.ai-report-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  border: 1rpx solid #eee;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.ai-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.ai-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.ai-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #6c63ff;
  letter-spacing: 2rpx;
}

.ai-content {
  background: #f8f9fa;
  padding: 24rpx;
  border-radius: 16rpx;
  min-height: 120rpx;
  display: flex;
  align-items: center;
  border: 1rpx dashed rgba(108, 99, 255, 0.3);
}

.ai-content.loading {
  justify-content: center;
}

.ai-typing {
  color: #6c63ff;
  font-size: 26rpx;
  font-style: italic;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% { opacity: 0.5; }
  50% { opacity: 1; }
  100% { opacity: 0.5; }
}

.ai-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
}

.ai-error {
  color: #e74c3c;
  font-size: 26rpx;
}

.ai-footer {
  margin-top: 20rpx;
  display: flex;
  justify-content: flex-end;
}

.btn-copy {
  background: rgba(108, 99, 255, 0.1);
  color: #6c63ff;
  border: 1rpx solid rgba(108, 99, 255, 0.2);
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  margin: 0;
  line-height: 1.5;
}

.btn-copy:active {
  background: rgba(108, 99, 255, 0.2);
}

.section-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
  display: block;
}

/* 结算清单区域 */
.summary-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #eee;
}

.summary-list {
  display: flex;
  flex-direction: column;
}

.summary-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx dashed #f0f0f0;
}

.summary-item:last-child {
  border-bottom: none;
}

.table-fee-item {
  margin-top: 10rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid #f0f0f0;
  border-bottom: none;
}

.s-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.s-score {
  font-size: 36rpx;
  font-weight: bold;
}

.table-score {
  color: #e67e22;
}

.pos { color: #e74c3c; }
.neg { color: #27ae60; }
.zero { color: #999; }

.actions {
  margin-top: 80rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.btn-back {
  background: #3e4459;
  color: #fff;
  border-radius: 50rpx;
  font-size: 30rpx;
}

.pos { color: #e74c3c; }
.neg { color: #27ae60; }

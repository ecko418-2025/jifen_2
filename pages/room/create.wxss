.container {
  padding: 60rpx 40rpx;
  background-color: #0f111a;
  min-height: 100vh;
  color: #fff;
}

.header {
  margin-bottom: 60rpx;
}

.avatar-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  border-radius: 80rpx;
  background: #1a1d29;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.hint {
  font-size: 22rpx;
  color: #6c63ff;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}

.desc {
  font-size: 26rpx;
  color: #8f94a5;
}

.form-item {
  margin-bottom: 40rpx;
}

.label {
  font-size: 24rpx;
  color: #8f94a5;
  display: block;
  margin-bottom: 20rpx;
}

.input {
  height: 100rpx;
  background: #1a1d29;
  border-radius: 20rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
}

.btn-submit {
  margin-top: 80rpx;
  height: 100rpx;
  line-height: 100rpx;
  background: #6c63ff;
  color: #fff;
  border-radius: 50rpx;
  font-weight: bold;
}

<view class="result-container">
  <view class="podium">
    <text class="congrats">🎉 牌局结束</text>
    <view class="winner-card" wx:if="{{winner}}">
      <text class="label">大赢家</text>
      <text class="winner-name">{{winner.nickname}}</text>
      <text class="winner-score">+{{winner.current_score}}</text>
    </view>
  </view>

  <view class="transfer-section">
    <text class="section-title">💡 最优平账方案 (只需 {{transfers.length}} 次转账)</text>
    <view wx:for="{{transfers}}" wx:key="index" class="transfer-item">
      <view class="p-info">
        <text class="from">{{item.from}}</text>
        <text class="arrow">支付 ¥{{item.amount}} 给</text>
        <text class="to">{{item.to}}</text>
      </view>
    </view>
  </view>

  <view class="actions">
    <button class="btn-trend" bindtap="showTrendModal">📈 查看积分走势</button>
    <button class="btn-back" bindtap="goHome">回到首页</button>
  </view>

  <!-- 走势图弹窗 -->
  <view class="trend-modal" wx:if="{{showTrend}}">
    <view class="trend-mask" bindtap="hideTrendModal"></view>
    <view class="trend-content">
      <view class="trend-header">
        <text class="trend-title">本局积分走势</text>
        <text class="trend-close" bindtap="hideTrendModal">×</text>
      </view>
      <view class="trend-body">
        <canvas type="2d" id="trendCanvas" class="trend-canvas"></canvas>
        <view class="trend-stats">
          <view class="stat-item">
            <text class="stat-label">我的最终分</text>
            <text class="stat-val {{myCurrentScore >= 0 ? 'pos' : 'neg'}}">{{myCurrentScore}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">单局最高</text>
            <text class="stat-val pos">+{{myMaxDelta}}</text>
          </view>
        </view>
      </view>
      <view class="trend-footer">
        <button class="btn-close-trend" bindtap="hideTrendModal">确定</button>
      </view>
    </view>
  </view>
</view>

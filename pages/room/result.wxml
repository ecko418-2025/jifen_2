<view class="result-container">
  <view class="podium">
    <text class="congrats">🎉 牌局结束</text>
    <view class="winner-card" wx:if="{{winner}}">
      <text class="label">大赢家</text>
      <text class="winner-name">{{winner.nickname}}</text>
      <text class="winner-score">+{{winner.current_score}}</text>
    </view>
  </view>

  <!-- AI 战报区域 -->
  <view class="ai-report-section">
    <view class="ai-header">
      <text class="ai-icon">🤖</text>
      <text class="ai-title">AI 毒舌战报</text>
    </view>
    <view class="ai-content {{isGeneratingReport ? 'loading' : ''}}">
      <text wx:if="{{isGeneratingReport}}" class="ai-typing">正在为您撰写高情商战报...</text>
      <text wx:elif="{{aiReport}}" class="ai-text" user-select="true">{{aiReport}}</text>
      <text wx:else class="ai-error">战报生成失败，请稍后重试</text>
    </view>
    <view class="ai-footer" wx:if="{{!isGeneratingReport && aiReport}}">
      <button class="btn-copy" bindtap="copyReport">复制发群里</button>
    </view>
  </view>

  <view class="summary-section">
    <text class="section-title">📊 最终结算清单</text>
    <view class="summary-list">
      <view class="summary-item" wx:for="{{players}}" wx:key="_id" wx:if="{{!item.is_virtual || item.nickname.indexOf('台面') === -1}}">
        <text class="s-name">{{item.nickname}}</text>
        <text class="s-score {{item.current_score > 0 ? 'pos' : (item.current_score < 0 ? 'neg' : 'zero')}}">
          {{item.current_score > 0 ? '+' : ''}}{{item.current_score}}
        </text>
      </view>
      <!-- 台面费单列 -->
      <view class="summary-item table-fee-item" wx:if="{{tableFee > 0}}">
        <text class="s-name">💰 台面 (结余)</text>
        <text class="s-score table-score">{{tableFee}}</text>
      </view>
    </view>
  </view>

  <view class="actions">
    <button class="btn-back" bindtap="goHome">回到首页</button>
  </view>
</view>

diff --git a/cloudfunctions/room-manager/index.js b/cloudfunctions/room-manager/index.js
index c5e3bf1..919786e 100644
--- a/cloudfunctions/room-manager/index.js
+++ b/cloudfunctions/room-manager/index.js
@@ -86,10 +86,297 @@ function buildFinalSnapshot(players, tableFee) {
 
 exports.main = async (event, context) => {
   const { action, data } = event
-  const { OPENID } = cloud.getWXContext()
+  const wxContext = cloud.getWXContext()
+  // 兼容微信小程序调用 (OPENID) 和 Web 端调用 (uid)
+  const OPENID = wxContext.OPENID || (context.auth ? context.auth.uid : null)
 
   switch (action) {
 
+    // ─── 管理后台扫码登录鉴权 ──────────────────────────────────────────
+    
+    // 1. 检查是否为管理员/房主
+    case 'checkAdminStatus': {
+      try {
+        const countRes = await db.collection('Rooms').where({ host_id: OPENID }).count();
+        const isAdmin = countRes.total > 0;
+        
+        let nickname = '管理员';
+        if (isAdmin) {
+          const playerRes = await db.collection('Players').where({ user_id: OPENID, is_host: true }).limit(1).get();
+          if (playerRes.data.length > 0) {
+            nickname = playerRes.data[0].nickname;
+          }
+        }
+        return { success: true, isAdmin, nickname };
+      } catch (err) {
+        return { success: false, error: err.message };
+      }
+    }
+
+    // 2. 网页端创建登录 Ticket 并生成小程序码
+    case 'createLoginTicket': {
+      try {
+        const { envVersion } = data || {};
+        const ticketId = 'L_' + Math.random().toString(36).substring(2, 10) + Date.now().toString(36);
+        
+        // 写入 AdminLogins 记录
+        await db.collection('AdminLogins').add({
+          data: {
+            ticket_id: ticketId,
+            status: 'pending',
+            created_at: db.serverDate()
+          }
+        });
+        
+        let qrBase64 = '';
+        try {
+          // 生成小程序码（直接携带 ticketId 作为 scene）
+          const qrRes = await cloud.openapi.wxacode.getUnlimited({
+            scene: ticketId,
+            page: 'pages/index/index',
+            checkPath: false,
+            envVersion: envVersion || 'release'
+          });
+          qrBase64 = `data:image/png;base64,${qrRes.buffer.toString('base64')}`;
+        } catch (qrErr) {
+          console.warn('微信小程序码生成失败，开启备用普通二维码：', qrErr.message);
+        }
+        
+        return { success: true, ticketId, qrBase64 };
+      } catch (err) {
+        return { success: false, error: err.message };
+      }
+    }
+
+    // 2.5 网页端轮询检查 Ticket 授权状态
+    case 'checkTicket': {
+      try {
+        const { ticket } = data || {};
+        if (!ticket) return { success: false, error: '缺少 ticket 参数' };
+        
+        const res = await db.collection('AdminLogins').where({ ticket_id: ticket }).limit(1).get();
+        if (res.data.length === 0) return { success: false, error: '该二维码记录不存在' };
+        
+        const ticketDoc = res.data[0];
+        return { 
+          success: true, 
+          status: ticketDoc.status, 
+          sessionToken: ticketDoc.session_token || '' 
+        };
+      } catch (err) {
+        return { success: false, error: err.message };
+      }
+    }
+
+    // 3. 小程序端管理员扫码后点击“确认授权”
+    case 'adminAuthorizeTicket': {
+      try {
+        const { ticket } = data;
+        if (!ticket) return { success: false, error: '缺少 ticket 参数' };
+        
+        // 验证扫码者是不是房主管理员
+        const countRes = await db.collection('Rooms').where({ host_id: OPENID }).count();
+        if (countRes.total === 0) return { success: false, error: '无权操作，您不是房主管理员' };
+        
+        // 获取并校验该 Ticket
+        const loginRes = await db.collection('AdminLogins').where({ ticket_id: ticket }).limit(1).get();
+        if (loginRes.data.length === 0) return { success: false, error: '登录请求已失效或不存在' };
+        
+        const ticketDoc = loginRes.data[0];
+        if (ticketDoc.status !== 'pending') return { success: false, error: '该二维码已被使用或失效' };
+        
+        // 生成 sessionToken
+        const sessionToken = 'S_' + Math.random().toString(36).substring(2, 10) + Date.now().toString(36);
+        
+        // 更新 Ticket 状态，并绑定 sessionToken
+        await db.collection('AdminLogins').doc(ticketDoc._id).update({
+          data: {
+            status: 'authorized',
+            authorized_openid: OPENID,
+            session_token: sessionToken,
+            authorized_at: db.serverDate()
+          }
+        });
+        
+        // 写入 AdminSessions 集合
+        await db.collection('AdminSessions').add({
+          data: {
+            token: sessionToken,
+            openid: OPENID,
+            created_at: db.serverDate(),
+            expire_time: Date.now() + 2 * 3600 * 1000 // 2小时后过期
+          }
+        });
+        
+        return { success: true };
+      } catch (err) {
+        return { success: false, error: err.message };
+      }
+    }
+
+    // 4. 管理员动作代理核心接口（对网页端的读写操作进行 Session 校验和代理）
+    case 'adminAction': {
+      try {
+        const { sessionToken, subAction, collection, limit, playerId, score } = data || {};
+        
+        let isAdmin = false;
+        let authorizedOpenid = OPENID;
+
+        // 【方式 A】: 校验 SessionToken (扫码登录模式)
+        if (sessionToken) {
+          const sessionRes = await db.collection('AdminSessions').where({ token: sessionToken }).limit(1).get();
+          if (sessionRes.data.length > 0) {
+            const session = sessionRes.data[0];
+            if (session.expire_time > Date.now()) {
+              isAdmin = true;
+              authorizedOpenid = session.openid;
+            } else {
+              return { success: false, error: '会话已过期，请重新登录' };
+            }
+          } else {
+            return { success: false, error: '无效的会话令牌' };
+          }
+        } 
+        
+        // 【方式 B】: 校验当前 OPENID/UID 是否为管理员 (账号密码或微信登录)
+        if (!isAdmin) {
+          // 1. 尝试从数据库校验（是否是某个房间的房主）
+          if (OPENID) {
+            const countRes = await db.collection('Rooms').where({ host_id: OPENID }).count();
+            if (countRes.total > 0) {
+              isAdmin = true;
+            }
+          }
+          
+          // 2. 特殊逻辑：如果是 Web 端账号密码登录 (loginType 为 username)
+          // 在 TCB 中，能用账号密码登录 Web SDK 的通常就是开发者/管理员
+          if (!isAdmin && context.auth && context.auth.loginType === 'username') {
+            isAdmin = true;
+            authorizedOpenid = context.auth.uid;
+          }
+        }
+
+        if (!isAdmin) {
+          return { 
+            success: false, 
+            error: '权限不足', 
+            debug: { hasOpenid: !!OPENID, hasAuth: !!context.auth } 
+          };
+        }
+        
+        // 验证通过，代理执行数据库操作
+        switch (subAction) {
+          case 'count': {
+            const countRes = await db.collection(collection).count();
+            return { success: true, total: countRes.total };
+          }
+          case 'list': {
+            let listRes = await db.collection(collection).orderBy(collection === 'Rooms' ? 'created_at' : 'joined_at', 'desc').limit(limit || 20).get();
+            let dataList = listRes.data;
+            
+            // 如果是玩家列表，我们需要关联查询房间号
+            if (collection === 'Players' && dataList.length > 0) {
+              const roomIds = [...new Set(dataList.map(p => p.room_id))];
+              const roomsRes = await db.collection('Rooms').where({
+                _id: _.in(roomIds)
+              }).field({
+                _id: true,
+                room_code: true
+              }).get();
+              
+              const roomMap = {};
+              roomsRes.data.forEach(r => {
+                roomMap[r._id] = r.room_code;
+              });
+              
+              dataList = dataList.map(p => ({
+                ...p,
+                room_code: roomMap[p.room_id] || '未知'
+              }));
+            }
+            
+            return { success: true, data: dataList };
+          }
+          case 'updateScore': {
+            if (!playerId || score === undefined) return { success: false, error: '参数错误' };
+            await db.collection('Players').doc(playerId).update({
+              data: {
+                current_score: score,
+                update_time: db.serverDate()
+              }
+            });
+            return { success: true };
+          }
+          case 'settleRoom': {
+            const { roomId } = data || {};
+            if (!roomId) return { success: false, error: '缺少房间 ID' };
+            
+            const roomRes = await db.collection('Rooms').doc(roomId).get();
+            const room = roomRes.data;
+            if (!room) return { success: false, error: '房间不存在' };
+            if (room.status === 'closed') return { success: true, msg: '房间已结算' };
+            
+            const playersRes = await db.collection('Players').where({ room_id: roomId }).limit(1000).get();
+            const players = playersRes.data || [];
+            const finalSnapshot = buildFinalSnapshot(players, Number(room.table_fee || 0));
+
+            await db.collection('Rooms').doc(roomId).update({
+              data: {
+                status: 'closed',
+                closed_at: db.serverDate(),
+                closed_by: 'ADMIN_' + authorizedOpenid,
+                final_snapshot: finalSnapshot
+              }
+            });
+            return { success: true };
+          }
+          case 'deleteRoom': {
+            const { roomId } = data || {};
+            if (!roomId) return { success: false, error: '缺少房间 ID' };
+            
+            // 物理删除房间及关联数据
+            await Promise.all([
+              db.collection('Rooms').doc(roomId).remove(),
+              db.collection('Players').where({ room_id: roomId }).remove(),
+              db.collection('Rounds').where({ room_id: roomId }).remove()
+            ]);
+            
+            return { success: true };
+          }
+          case 'batchAutoSettle': {
+            const expireDays = data.expireDays || 5;
+            const cutoffTime = new Date(Date.now() - expireDays * 24 * 3600 * 1000);
+            const activeRoomsRes = await db.collection('Rooms').where({ status: 'active' }).limit(100).get();
+            let settledCount = 0;
+            
+            for (const room of activeRoomsRes.data) {
+              const createdAt = room.created_at ? new Date(room.created_at) : null;
+              if (createdAt && createdAt < cutoffTime) {
+                const playersRes = await db.collection('Players').where({ room_id: room._id }).limit(1000).get();
+                const players = playersRes.data || [];
+                const finalSnapshot = buildFinalSnapshot(players, Number(room.table_fee || 0));
+                
+                await db.collection('Rooms').doc(room._id).update({
+                  data: {
+                    status: 'closed',
+                    closed_at: db.serverDate(),
+                    closed_by: 'ADMIN_BATCH',
+                    final_snapshot: finalSnapshot
+                  }
+                });
+                settledCount++;
+              }
+            }
+            return { success: true, settledCount };
+          }
+          default:
+            return { success: false, error: '不支持的操作' };
+        }
+      } catch (err) {
+        return { success: false, error: err.message };
+      }
+    }
+
     // ─── 首页数据 ──────────────────────────────────────────────────────────
     case 'getHomeData': {
       try {

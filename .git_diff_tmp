+                    document.getElementById('login-overlay').classList.add('hidden');
+                    loadTab('dashboard');
+                }, 1500);
+            }
+        }
+    } catch (err) {
+        console.warn("轮询 Ticket 状态失败", err);
+    }
+}
+
+function stopQRCodePolling() {
+    if (qrPollTimer) {
+        clearInterval(qrPollTimer);
+        qrPollTimer = null;
+    }
+    activeTicketId = null;
+}
